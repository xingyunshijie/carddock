{
  "name": "carddock-github-update-20261031",
  "networks": {
    "default": {
      "name": "carddock-github-update-20261031_default",
      "ipam": {}
    }
  },
  "services": {
    "carddock": {
      "restart": "unless-stopped",
      "container_name": "carddock",
      "cap_drop": [
        "ALL"
      ],
      "command": null,
      "entrypoint": null,
      "environment": {
        "AUTHENTICATION_ENABLED": "true",
        "AUTHENTICATION_PASSWORD": "改成你自己的密码",
        "TZ": "Asia/Shanghai"
      },
      "image": "ghcr.io/xingyunshijie/carddock:1.0.0-nas.3",
      "networks": {
        "default": null
      },
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:size=128m,mode=1777"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "carddock-data",
          "target": "/state",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "/mnt/@usb",
          "target": "/sources",
          "read_only": true,
          "bind": {
            "propagation": "rslave"
          }
        },
        {
          "type": "bind",
          "source": "/volume2/NASgutai",
          "target": "/storage/area1",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/volume3/NAS02",
          "target": "/storage/area2",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/volume2/NASgutai",
          "target": "/manual/area1",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/volume3/NAS02",
          "target": "/manual/area2",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/proc/1/mountinfo",
          "target": "/host/mountinfo",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/sys",
          "target": "/sys",
          "read_only": true,
          "bind": {}
        }
      ],
      "ports": [
        {
          "mode": "ingress",
          "target": 8080,
          "published": "18080",
          "protocol": "tcp"
        }
      ]
    }
  },
  "volumes": {
    "carddock-data": {
      "name": "carddock-github-update-20261031_carddock-data"
    }
  }
}
